generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum UserRoles {
  MEMBER
  MANAGER
}

enum OrganizationRoles {
  OWNER
  MEMBER
  ADMIN
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Organizations
  createdOrganizations      Organization[]
  organizationMemberships   OrganizationMember[]
  sentInvitations           Invitation[]

  // Projects
  ownedProjects             Project[]
  projectMemberships        ProjectMember[]

  // Tasks
  taskCreated               Task[] @relation("TaskCreator")
  assignedTask              Task[] @relation("TaskAssignee")

  // Comments & Activities
  comments                  Comment[]
  activities                Activity[]
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String

  creatorId Int
  creator   User @relation(fields: [creatorId], references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects      Project[]
  members       OrganizationMember[]
  invitations   Invitation[]
  activities    Activity[]
}

model Invitation {
  id Int @id @default(autoincrement())

  email String

  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id],onDelete: Cascade)

  invitedBy Int
  inviter User @relation(fields: [invitedBy], references: [id],onDelete: Cascade)

  role OrganizationRoles @default(MEMBER)

  status InvitationStatus @default(PENDING)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
}

model Project {
  id Int @id @default(autoincrement())

  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id],onDelete: Cascade)

  ownerId Int
  owner User @relation(fields: [ownerId], references: [id],onDelete: Cascade)

  name String
  description String?

  startDate DateTime?
  dueDate DateTime?
  completedAt DateTime?

  status ProjectStatus @default(PLANNING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
  members ProjectMember[]
  activities Activity[]
}

model Task {
  id Int @id @default(autoincrement())

  projectId Int
  project Project @relation(fields: [projectId], references: [id],onDelete: Cascade)

  title String
  description String?

  createdBy Int
  created User @relation("TaskCreator", fields: [createdBy], references: [id],onDelete: Cascade)

  assignedTo Int
  assignee User @relation("TaskAssignee", fields: [assignedTo], references: [id],onDelete: Cascade)

  status TaskStatus @default(TODO)
  priority TaskPriority @default(MEDIUM)

  dueDate DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]
  activities Activity[]
}

model OrganizationMember {
  id Int @id @default(autoincrement())

  userId Int
  user User @relation(fields: [userId], references: [id],onDelete: Cascade)

  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id],onDelete: Cascade)

  role OrganizationRoles @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
}

model ProjectMember {
  id Int @id @default(autoincrement())

  projectId Int
  project Project @relation(fields: [projectId], references: [id],onDelete: Cascade)

  userId Int
  member User @relation(fields: [userId], references: [id],onDelete: Cascade)

  role UserRoles @default(MEMBER)

  joinedAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Comment {
  id Int @id @default(autoincrement())

  taskId Int
  task Task @relation(fields: [taskId], references: [id],onDelete: Cascade)

  userId Int
  user User @relation(fields: [userId], references: [id],onDelete: Cascade)

  message String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id Int @id @default(autoincrement())

  userId Int
  user User @relation(fields: [userId], references: [id],onDelete: Cascade)

  organizationId Int?
  organization Organization? @relation(fields: [organizationId], references: [id],onDelete: Cascade)

  projectId Int?
  project Project? @relation(fields: [projectId], references: [id],onDelete: Cascade)

  taskId Int?
  task Task? @relation(fields: [taskId], references: [id],onDelete: Cascade)

  action String
  description String?

  createdAt DateTime @default(now())
}